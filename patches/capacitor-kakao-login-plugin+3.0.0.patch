+// swift-tools-version: 5.9
+// node_modules 내에 추가한 SPM manifest — Capacitor 8 SPM 통합용.
+// 이 플러그인은 podspec만 제공하므로 npm install 시 본 파일이 사라진다.
+// 영구화는 patch-package 또는 fork로 별도 처리 (#31 후속 이슈).
+import PackageDescription
+
+let package = Package(
+    name: "CapacitorKakaoLoginPlugin",
+    platforms: [.iOS(.v13)],
+    products: [
+        .library(
+            name: "CapacitorKakaoLoginPlugin",
+            targets: ["CapacitorKakaoLoginPlugin"])
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", exact: "8.3.1"),
+        .package(url: "https://github.com/kakao/kakao-ios-sdk", from: "2.22.0")
+    ],
+    targets: [
+        .target(
+            name: "CapacitorKakaoLoginPlugin",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm"),
+                .product(name: "Cordova", package: "capacitor-swift-pm"),
+                .product(name: "KakaoSDKCommon", package: "kakao-ios-sdk"),
+                .product(name: "KakaoSDKAuth", package: "kakao-ios-sdk"),
+                .product(name: "KakaoSDKUser", package: "kakao-ios-sdk"),
+                .product(name: "KakaoSDKTalk", package: "kakao-ios-sdk"),
+                .product(name: "KakaoSDKShare", package: "kakao-ios-sdk"),
+                .product(name: "KakaoSDKTemplate", package: "kakao-ios-sdk"),
+            ],
+            path: "ios/Plugin"
+        )
+    ]
+)
