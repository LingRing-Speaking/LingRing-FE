VITE_API_BASE_URL=https://api-dev.lingring.site

# 카카오 디벨로퍼 콘솔에서 발급받은 네이티브 앱 키
# - 네이티브 빌드(iOS/Android) 시 Info.plist / AndroidManifest 에도 동일 값을 주입
# - 빈 값이면 카카오 SDK 초기화가 깨짐 (개발 단계에선 콘솔에서 받은 값으로 채울 것)
VITE_KAKAO_NATIVE_APP_KEY=

# dev 모드에서 두 탭으로 통화 e2e 검증할 때:
#   탭 1: http://localhost:5173/?userId=1
#   탭 2: http://localhost:5173/?userId=2
# ?userId 가 sessionStorage 에 저장되어 그 탭의 라우터 이동에도 유지됨

# 개발 중에 백엔드 mock(MSW)을 켜려면 on. 평소엔 off로 진짜 BE 호출.
VITE_MSW=off

# Sentry 크래시·에러 모니터링 (#198)
# - DSN 은 공개돼도 되는 값 (클라이언트 배포물에 포함되는 게 정상).
#   sentry.io → Settings → Projects → Client Keys (DSN) 에서 확인.
# - DSN 과 VITE_SENTRY_ENVIRONMENT 둘 다 있어야 초기화된다. environment 는
#   채널 빌드 스크립트(build:ios:dev/prod 등)가 dev|prod 로 주입하므로 여기엔
#   두지 않는다 → 로컬 웹 개발·QA 빌드는 Sentry 를 태우지 않는 것이 기본.
# - 실기기에서 수신 검증 등 로컬에서 강제로 켜려면:
#   VITE_SENTRY_ENVIRONMENT=dev npm run dev:ios
# - release 는 OTA 버전과 동일한 major.minor.커밋수 를 vite 가 자동 주입.
VITE_SENTRY_DSN=

# JS 소스맵 업로드 (선택 — 없으면 업로드만 생략되고 빌드는 정상 진행)
# 토큰은 시크릿이다. sentry.io → Settings → Auth Tokens 에서 발급
# (project:releases 스코프). org/project 는 sentry.io 의 슬러그.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# OTA 매니페스트 URL (네이티브에서만 사용). 앱이 이 주소를 CapacitorHttp 로 GET 해
# 최신 번들을 판별한다. 미설정이면 OTA 확인을 건너뛴다(웹 개발 시 정상).
# 채널 격리: dev 앱은 ota-dev, prod 앱은 ota 를 본다.
# - 로컬 검증: http://localhost:8888/manifest.json (npm run serve:ota)
# - dev:  https://ota-dev.lingring.site/manifest.json
# - prod: https://ota.lingring.site/manifest.json
# 채널별 빌드는 npm run build:ios:dev / build:ios:prod, 번들 배포는
# npm run deploy:ota:dev / deploy:ota:prod 가 이 값을 자동 주입한다.
VITE_OTA_UPDATE_URL=
